# Frontend environment (public, no secrets). Copy to client/.env for local overrides.
# In local dev the Vite proxy forwards /api -> http://localhost:5000, so this can be left empty.
# For production, set VITE_API_URL to the deployed backend API origin.
# VITE_API_URL=https://cswithak.onrender.com/api
VITE_API_URL=http://localhost:5000/api
