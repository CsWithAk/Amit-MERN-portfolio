# ---- Admin (single administrator, NO registration) ----
ADMIN_USERNAME=admin
# Generate with: npm run hash-password your_password
ADMIN_PASSWORD_HASH=
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# ---- Database ----
# MongoDB Atlas connection string. If empty, the server falls back to an
# in-memory MongoDB (development only) so the app can be tested locally.
MONGODB_URI=

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=dllii90b0
CLOUDINARY_API_KEY=376768786363911
CLOUDINARY_API_SECRET=wcOI8-0aJiXgpz0vDBEfpWekiHc

# ---- Email notifications (SendGrid Web API — NOT SMTP) ----
# Uses the official @sendgrid/mail SDK. Email is optional: without a key the app
# still boots and contact messages are saved to MongoDB (just not emailed).
#   SENDGRID_API_KEY       -> https://app.sendgrid.com/settings/api_keys
#   SENDGRID_FROM_EMAIL    -> a VERIFIED single sender (SendGrid sender identity)
#   CONTACT_RECEIVER_EMAIL -> where admin notifications go (defaults to the from email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CONTACT_RECEIVER_EMAIL=
# Optional: log instead of actually sending (never hits the network). Great for local/CI.
SENDGRID_DRY_RUN=false

# ---- App ----
FRONTEND_URL=https://cswithak.netlify.app
PORT=5000
NODE_ENV=development
